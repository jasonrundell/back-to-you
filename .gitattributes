# cmd mis-parses "::" comment lines containing non-ASCII characters when a
# batch file has LF endings, so force CRLF on checkout for Windows scripts.
*.bat text eol=crlf
*.ps1 text eol=crlf

# The macOS scripts must be LF. A CRLF shebang makes sh fail with
# "bad interpreter: /bin/sh^M", which is a baffling error to land on.
*.sh text eol=lf
*.command text eol=lf
*.js text eol=lf
*.json text eol=lf

*.mp3 binary
*.wav binary
